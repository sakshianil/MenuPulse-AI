{
  "name": "menupulse-ai",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @menupulse/api --filter @menupulse/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @menupulse/api prisma:generate",
    "db:migrate": "pnpm --filter @menupulse/api prisma:migrate",
    "db:seed": "pnpm --filter @menupulse/api prisma:seed"
  },
  "engines": {
    "node": ">=20"
  }
}
